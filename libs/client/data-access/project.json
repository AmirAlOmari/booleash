{
  "name": "client-data-access",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/client/data-access/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "implicitDependencies": ["tablit-server"],
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "dependsOn": ["tablit-server:generate-gql-schema"],
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "graphql-codegen",
          "prettier -w ./src/lib/generated.ts",
          "nx run client-data-access:lint -- --fix"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.gql", "{projectRoot}/codegen.ts"],
      "outputs": ["{projectRoot}/src/lib/generated.ts"]
    },
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "dependsOn": ["codegen"],
      "options": {
        "project": "libs/client/data-access/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/client/data-access/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/client/data-access/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/client/data-access/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
