{
  "name": "redis",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/server/redis/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/server/redis",
        "tsConfig": "libs/server/redis/tsconfig.lib.json",
        "packageJson": "libs/server/redis/package.json",
        "main": "libs/server/redis/src/index.ts",
        "assets": ["libs/server/redis/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/server/redis/jest.config.ts"
      }
    }
  }
}
